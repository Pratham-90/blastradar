# Copy to `.env` (gitignored) and fill in. The CLI and Phase 0 scripts read these.
# Get a DataHub token from the UI: Settings -> Access Tokens -> Generate.
#
# NOTE: the offline `make demo` and `make test` need NONE of these — they replay
# recorded fixtures (no DataHub, network, or key). You only need this file for the
# live path (`make demo-live`, `make record-fixtures`, or running the CLI against a
# real DataHub). `make demo-live` sets DATAHUB_GMS_URL + TOOLS_IS_MUTATION_ENABLED for
# you. (Advanced: set BLASTRADAR_REPLAY=<recording.json> to force the CLI offline.)

# --- DataHub (read lineage + write-back) ------------------------------------
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=

# --- Write-back kill-switch (Phase 1D) --------------------------------------
# DataHub mutations (incident / tag / document) are DISABLED by default. Set this
# to exactly "true" to let Blastradar write findings back. Without it the analysis
# and PR comment still run, and the comment says write-back was skipped.
#   *** #1 setup gotcha: if incidents aren't showing up in DataHub, this is unset. ***
TOOLS_IS_MUTATION_ENABLED=false

# --- LLM narration (Phase 1C; optional) -------------------------------------
# Blastradar makes exactly ONE LLM call per run, to write prose only (never to
# decide impact). The provider is auto-selected at runtime:
#   1. GROQ_API_KEY set      -> Groq (OpenAI-compatible; default model below)
#   2. else ANTHROPIC_API_KEY -> Anthropic claude-opus-4-8
#   3. neither / any API error / --no-llm -> fully-templated prose (still works)
# If BOTH keys are set, Groq wins. If NEITHER is set, the tool still runs and the
# comment is written from templates.
ANTHROPIC_API_KEY=

# Groq path (optional). Set GROQ_API_KEY to narrate via Groq. GROQ_MODEL and
# GROQ_BASE_URL are optional overrides; the defaults are shown.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- GitHub PR comment (Phase 1D; set by Actions automatically in CI) --------
# Only needed for local posting. In GitHub Actions the workflow injects GITHUB_TOKEN.
GITHUB_TOKEN=
